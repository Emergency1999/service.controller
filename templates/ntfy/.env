# --- https://docs.ntfy.sh/config/ ---
DOMAIN=
TIME_ZONE=

#* Accounts, grants and tokens live in auth.env (loaded into the container via
#* `env_file` in docker-compose.yml) and are managed with ./service.sh users.

#* Web Push — background notifications in the browser, also when the web app is closed.
#* VAPID keypair, generated with `docker run --rm binwiederhier/ntfy webpush keys`.
#* Changing it invalidates every existing browser subscription.
NTFY_WEB_PUSH_PUBLIC_KEY=
NTFY_WEB_PUSH_PRIVATE_KEY=

# TODO: admin contact address, handed to the browser push providers (Google/Mozilla/Apple)
#       so they can reach you about the push subscriptions. Required — ntfy refuses to
#       start with web push configured but no address.
NTFY_WEB_PUSH_EMAIL_ADDRESS=
