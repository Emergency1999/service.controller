DOMAIN=euro-office.example.com

EURO_OFFICE_VERSION=v9.3.3

TIME_ZONE=Europe/Berlin

# Shared secret between this document server and the Nextcloud Office
# (eurooffice) app. Both sides must carry the exact same value.
# HS256 needs >= 32 characters; generate with `openssl rand -hex 32`.
EURO_OFFICE_JWT_SECRET=

# Public URL of the Nextcloud that will use this document server.
# No trailing slash. Not consumed by the container — used by
# `./service.sh connect` and documented in SETUP.md.
NEXTCLOUD_URL=https://nextcloud.example.com
