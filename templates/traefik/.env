HETZNER_DNS_API_TOKEN=TOKEN

# CrowdSec. Bouncer key of the traefik plugin: `openssl rand -hex 32`. A changed key needs
# `./service.sh exec crowdsec cscli bouncers delete traefik` first: the start registers the bouncer only when its name is new.
CROWDSEC_BOUNCER_KEY=
# CrowdSec Console (app.crowdsec.net): enroll key of the organisation and the name of this engine (the host).
# With a key set, the start needs CAPI reachable, and the engine is accepted once in the Console.
CROWDSEC_ENROLL_KEY=
CROWDSEC_ENROLL_INSTANCE_NAME=
