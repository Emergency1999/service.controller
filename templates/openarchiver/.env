DOMAIN=openarchiver.example.com
DOMAIN_MCP=mcp-openarchiver.example.com

OPENARCHIVER_VERSION=latest
POSTGRES_VERSION=17-alpine
VALKEY_VERSION=8-alpine
MEILISEARCH_VERSION=v1.38
TIKA_VERSION=3.2.2.0-full

# --- OpenArchiver app secrets (consumed via env_file) ---
# openssl rand -hex 32 each; STORAGE_ENCRYPTION_KEY must never change after
# the first ingest or archived mail becomes unreadable.
STORAGE_ENCRYPTION_KEY=
JWT_SECRET=
ENCRYPTION_KEY=

# --- stack-internal credentials (openssl rand -hex 24) ---
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
REDIS_PASSWORD=

# --- MCP server (see mcp/openarchiver/README.md) ---
# API key created in the OpenArchiver UI, sent upstream as X-API-KEY
OPENARCHIVER_API_KEY=
# secret embedded in the MCP endpoint path — openssl rand -hex 24
MCP_URL_TOKEN=
