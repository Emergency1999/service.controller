DOMAIN=paperless.example.com
TIME_ZONE=Europe/Berlin

PAPERLESS_VERSION=3.0.5
POSTGRES_VERSION=17
REDIS_VERSION=8
GOTENBERG_VERSION=8.36.0
TIKA_VERSION=3.3.1.0

#* Required before the first `up` - paperless refuses to start without it.
#* Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#* Never rotate this later: existing sessions and tokens are signed with it.
PAPERLESS_SECRET_KEY=

#* OIDC / authentik login.
#* The compose file ships with PAPERLESS_DISABLE_REGULAR_LOGIN=True, so these must be
#* filled in before the first `up` or nobody can log into the UI.
#* To use username/password login instead, set PAPERLESS_DISABLE_REGULAR_LOGIN=False in
#* docker-compose.yml and create an account with: ./service.sh createsuperuser
PAPERLESS_OIDC_NAME=
PAPERLESS_OIDC_CLIENT_ID=
PAPERLESS_OIDC_SECRET=
PAPERLESS_OIDC_SERVER_URL=

#* Optional: ping this URL after a successful borg backup (e.g. an uptime-kuma push monitor)
BORG_SUCCESS_URL=
